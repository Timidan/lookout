# Required. 32 random bytes as 64 hex digits; encrypts trading keys at rest.
# Create one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=
DB_PATH=./glasses.db
PORT=8790
# Origins allowed to call the API (the glasses app), comma separated.
ALLOWED_ORIGINS=http://localhost:5173
# Public address of this server; the pairing link is built from it.
PUBLIC_BASE_URL=http://localhost:8790
# Largest new order in USD. Closing orders are not capped.
MAX_ORDER_USD=200
SLIPPAGE_BPS=100
# Optional. A testnet address shown read-only before a wallet is paired.
SAMPLE_ADDRESS=
# Optional. An OpenAI-compatible speech-to-text endpoint, e.g. a local Whisper server.
STT_BASE_URL=
STT_MODEL=
STT_API_KEY=
